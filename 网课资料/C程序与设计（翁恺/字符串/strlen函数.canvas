		{"id":"c1fc486cd45762e1","type":"text","text":"#include <stdio.h>\n\n#include <string.h>\n\n  \n\nint mystrlen(const char* s) {\n\n    int i;\n\n    for (i = 0;s[i] != '\\0';i++) {\n\n    };\n\n    return i;\n\n}\n\n  \n\nint main() {//argc:字符个数\n\n    char line[] = \"Hello\";\n\n    printf(\"mystrlen=%d\\n\", mystrlen(line));\n\n    printf(\"strlen=%llu\\n\", strlen(line));\n\n    printf(\"sizeof=%llu\\n\", sizeof(line));\n\n    return 0;\n\n}","x":-320,"y":320,"width":400,"height":620}
