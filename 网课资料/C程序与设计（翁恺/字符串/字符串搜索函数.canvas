		{"id":"5a2a4b569c99b852","type":"text","text":"#include <stdio.h>\n#include <string.h>\n\nint main() {\n    char s[] = \"Hello\";\n    char* p = strchr(s, 'l');\n    printf(\"%p\\n\", s);\n    p = strchr(p+1, 'l');\n    printf(\"%p\\n\", p);\n    printf(\"%s\\n\", p);\n    return 0;\n}","x":-320,"y":80,"width":340,"height":320},
		{"id":"b9af87ca6b23885f","type":"text","text":"#include <stdio.h>\n#include <string.h>\n#include <stdlib.h>\n\nint main() {\n    char s[] = \"Hello\";\n    char* p = strchr(s, 'l');\n    char* t = (char*)malloc(strlen(p) + 1);\n    strcpy(t, p);\n    printf(\"%s\\n\", t);\n    free(t);\n    return 0;\n}","x":-320,"y":420,"width":280,"height":380},
