		{"id":"4bf2a9ff73bc09a9","type":"text","text":"#include <stdio.h>\n#include <string.h>\n\nint mycmp(const char* s1, const char* s2) {\n    /*int idx=0;\n    while (s1[idx]==s2[idx] && s2[idx]!= '\\0'){\n    idx++;\n    }\n    */\n    while (*s1 == *s2 && *s1 != '\\0') {\n        s1++;\n        s2++;\n    }\n    return *s1 - *s2;\n}\n\nint main() {\n    char s1[] = \"abca\";\n    char s2[] = \"abc\";\n    printf(\"%d\\n\", strcmp(s1, s2));\n    printf(\"%d\\n\", mycmp(s1, s2));\n    return 0;\n}","x":-340,"y":80,"width":380,"height":580}
